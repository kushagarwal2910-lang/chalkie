  "segments": [
    {
      "id": "seg1",
      "title": "Setpoint and Comparison",
      "narration": "First we set the desired temperature – the target temperature – and feed it into the comparator where it meets the sensed room temperature.",
      "targetIds": [
        "obj_target",
        "obj_comparator"
      ],
      "action": "reveal",
      "durationMs": 8000
    },
    {
      "id": "seg2",
      "title": "Controller to Heater",
      "narration": "The comparator outputs an error signal to the controller, which decides how much power to send to the heater.",
      "targetIds": [
        "obj_controller",
        "obj_heater"
      ],
      "action": "focus",
      "durationMs": 7000
    },
    {
      "id": "seg3",
      "title": "Heating the Room",
      "narration": "The heater injects warm air into the room, raising the room temperature.",
      "targetIds": [
        "obj_heater",
        "obj_room"
      ],
      "action": "pulse",
      "durationMs": 6000
    },
    {
      "id": "seg4",
      "title": "Sensor Feedback Loop",
      "narration": "A sensor measures the new room temperature and sends that feedback back to the comparator, closing the negative‑feedback loop.",
      "targetIds": [
        "obj_sensor",
        "obj_comparator"
      ],
      "action": "trace",
      "durationMs": 9000
    },
    {
      "id": "seg5",
      "title": "Cold‑Air Disturbance",
      "narration": "If a cold‑air draft enters the room, the sensor detects a drop, the comparator sees a larger error, and the controller ramps up the heater to compensate.",
      "targetIds": [
        "obj_disturb",
        "obj_room",
        "obj_sensor"
      ],
      "action": "flow",
      "durationMs": 10000
    }
  ]
