  "segments": [
    {
      "id": "seg1",
      "title": "Client Request Distribution",
      "narration": "Clients send HTTP requests to the Load Balancer, which instantly forwards each request to one of the three App Servers based on its routing algorithm.",
      "targetIds": [
        "lb",
        "app1",
        "app2",
        "app3"
      ],
      "action": "reveal",
      "durationMs": 8000
    },
    {
      "id": "seg2",
      "title": "Cache Hit Path",
      "narration": "When an App Server receives a request, it first checks the Shared Cache. If the needed data is already cached, the server reads it and sends the response straight back to the client.",
      "targetIds": [
        "app1",
        "cache"
      ],
      "action": "focus",
      "durationMs": 9000
    },
    {
      "id": "seg3",
      "title": "Cache Miss Path",
      "narration": "If the cache does not contain the requested item, the App Server experiences a cache miss, queries the Shared Database, retrieves the data, and then populates the cache for future hits.",
      "targetIds": [
        "app2",
        "db"
      ],
      "action": "trace",
      "durationMs": 10000
    },
    {
      "id": "seg4",
      "title": "Response Delivery",
      "narration": "After either a cache hit or a database fetch, the App Server returns the data to the client, completing the request‑response cycle.",
      "targetIds": [
        "app3"
      ],
      "action": "pulse",
      "durationMs": 7000
    }
  ]
}
